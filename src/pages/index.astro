
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<BaseLayout
  title="Finavit Journal — Nutrition, Food & Wellness"
  description="Explore practical, evidence-informed guides to nutrition, vitamins, food, and healthier everyday choices."
>
  <section class="hero">
    <div class="hero-content">
      <span class="eyebrow"><span class="dot"></span> THE FINAVIT JOURNAL</span>
      <h1>Understand your food.<br /><span>Understand your health.</span></h1>
      <p>
        Straightforward guides to nutrition, vitamins, food, and wellness.
        Reliable information to help you make more informed everyday choices.
      </p>
      <a class="hero-button" href="#explore">
        Explore the journal <span>↗</span>
      </a>
      <div class="hero-note">
        <span class="note-line"></span>
        CURIOUS MINDS. INFORMED CHOICES.
      </div>
    </div>

    <div class="hero-art" aria-hidden="true">
      <div class="art-circle circle-one"></div>
      <div class="art-circle circle-two"></div>
      <div class="art-label label-top">NOURISH</div>
      <div class="art-label label-bottom">THRIVE</div>
      <div class="art-center">
        <span class="leaf">✳</span>
        <span class="art-center-text">A healthier<br />perspective.</span>
      </div>
      <div class="art-small small-one">+</div>
      <div class="art-small small-two">✳</div>
    </div>
  </section>

  <section class="intro" id="explore">
    <div>
      <span class="section-label">A LITTLE KNOWLEDGE GOES A LONG WAY</span>
      <h2>Health information,<br />without the noise.</h2>
    </div>
    <p>
      Nutrition can feel complicated. We make it easier to explore by breaking
      down everyday questions into clear, approachable articles grounded in
      credible information.
    </p>
  </section>

  <section class="topics">
    <div class="section-heading">
      <div>
        <span class="section-label">EXPLORE THE JOURNAL</span>
        <h2>Find what interests you.</h2>
      </div>
      <span class="heading-number">01 — 04</span>
    </div>

    <div class="topic-grid">
      <a class="topic-card nutrition" href="#latest">
        <span class="topic-number">01 / NUTRITION</span>
        <span class="topic-icon">◉</span>
        <h3>Nutrition</h3>
        <p>Understand nutrients, balanced diets, and how food supports your body.</p>
        <span class="topic-arrow">↗</span>
      </a>

      <a class="topic-card vitamins" href="#latest">
        <span class="topic-number">02 / VITAMINS</span>
        <span class="topic-icon">✳</span>
        <h3>Vitamins</h3>
        <p>Explore essential vitamins, their food sources, and what they do.</p>
        <span class="topic-arrow">↗</span>
      </a>

      <a class="topic-card food" href="#latest">
        <span class="topic-number">03 / FOOD</span>
        <span class="topic-icon">◌</span>
        <h3>Food & Ingredients</h3>
        <p>Discover everyday ingredients and the nutritional value they offer.</p>
        <span class="topic-arrow">↗</span>
      </a>

      <a class="topic-card wellness" href="#latest">
        <span class="topic-number">04 / WELLNESS</span>
        <span class="topic-icon">⌁</span>
        <h3>Wellness</h3>
        <p>Learn about everyday habits that contribute to overall well-being.</p>
        <span class="topic-arrow">↗</span>
      </a>
    </div>
  </section>

  
<section class="latest" id="latest">
  <div class="section-heading">
    <div>
      <span class="section-label">FRESH PERSPECTIVES</span>
      <h2>Latest articles.</h2>
    </div>
    <span class="heading-number">{articles.length} ARTICLES</span>
  </div>

  {articles.length > 0 ? (
    <div class="article-grid">
      {articles.map((article) => (
        <a
          class="article-card"
          href={`${import.meta.env.BASE_URL}/${article.id}/`}
        >
          {article.data.image ? (
            <img
              class="article-thumbnail"
              src={article.data.image}
              alt={article.data.imageAlt || article.data.title}
            />
          ) : (
            <div class="article-placeholder">
              <span>✳</span>
            </div>
          )}

          <div class="article-card-content">
            <span class="article-category">{article.data.category}</span>
            <h3>{article.data.title}</h3>
            <p>{article.data.description}</p>
            <div class="article-card-bottom">
              <time datetime={article.data.pubDate.toISOString()}>
                {article.data.pubDate.toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </time>
              <span>Read article ↗</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <span class="empty-icon">✳</span>
      <h3>Good reads are on the way.</h3>
      <p>We're preparing our first collection of nutrition and food guides.</p>
    </div>
  )}
</section>


  <section class="closing">
    <span class="section-label">YOUR JOURNEY STARTS WITH KNOWLEDGE</span>
    <h2>Small discoveries.<br /><span>Better-informed choices.</span></h2>
    <p>Explore the world of nutrition, one question at a time.</p>
    <a href="https://finavit.com" class="closing-button">Discover Finavit ↗</a>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 570px;
    padding: 90px clamp(24px, 9vw, 140px);
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 50px;
    background: #f1f3eb;
    overflow: hidden;
  }

  .hero-content {
    max-width: 650px;
  }

  .eyebrow,
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #647767;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #6d966e;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  .hero h1 {
    margin: 25px 0 22px;
    font-family: 'DM Serif Display', serif;
    font-size: clamp(44px, 5.4vw, 76px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -2px;
  }

  .hero h1 span,
  .closing h2 span {
    color: #66846b;
  }

  .hero-content > p {
    max-width: 490px;
    color: #68736a;
    font-size: 15px;
    line-height: 1.9;
  }

  .hero-button,
  .closing-button {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    margin-top: 20px;
    padding: 15px 21px;
    border-radius: 4px;
    background: #244c38;
    color: white;
    font-size: 13px;
    font-weight: 600;
    transition: background 0.2s, transform 0.2s;
  }

  .hero-button:hover,
  .closing-button:hover {
    background: #376447;
    transform: translateY(-2px);
  }

  .hero-note {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 55px;
    color: #8a968b;
    font-size: 9px;
    letter-spacing: 1.6px;
    font-weight: 600;
  }

  .note-line {
    width: 28px;
    height: 1px;
    background: #8a968b;
  }

  .hero-art {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 350px;
  }

  .art-circle {
    position: absolute;
    border: 1px solid #c7d2c1;
    border-radius: 50%;
  }

  .circle-one {
    width: 310px;
    height: 310px;
  }

  .circle-two {
    width: 245px;
    height: 245px;
    border-style: dashed;
    border-color: #a9bca8;
  }

  .art-center {
    z-index: 1;
    display: flex;
    width: 185px;
    height: 185px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 12px;
    border-radius: 50%;
    background: #dce6d7;
    text-align: center;
  }

  .leaf {
    color: #547b59;
    font-size: 43px;
  }

  .art-center-text {
    color: #355640;
    font-family: 'DM Serif Display', serif;
    font-size: 19px;
    line-height: 1.2;
  }

  .art-label {
    position: absolute;
    color: #6d806d;
    font-size: 9px;
    letter-spacing: 2px;
    font-weight: 700;
  }

  .label-top {
    top: 25px;
    right: 20px;
  }

  .label-bottom {
    bottom: 25px;
    left: 20px;
  }

  .art-small {
    position: absolute;
    color: #789578;
    font-size: 25px;
  }

  .small-one {
    top: 60px;
    left: 35px;
  }

  .small-two {
    right: 25px;
    bottom: 65px;
  }

  .intro {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: 80px;
    align-items: end;
    padding: 100px clamp(24px, 10vw, 150px);
  }

  .intro h2,
  .section-heading h2,
  .closing h2 {
    margin: 17px 0 0;
    font-family: 'DM Serif Display', serif;
    font-size: clamp(32px, 3.5vw, 46px);
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: -0.7px;
  }

  .intro > p {
    max-width: 470px;
    margin-bottom: 4px;
    color: #778078;
    font-size: 14px;
    line-height: 1.9;
  }

  .topics,
  .latest {
    padding: 30px clamp(24px, 7vw, 110px) 80px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 35px;
  }

  .section-heading h2 {
    font-size: clamp(30px, 3vw, 40px);
  }

  .heading-number,
  .coming-soon {
    color: #8a968b;
    font-size: 10px;
    letter-spacing: 1.5px;
    font-weight: 600;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
  }

  .topic-card {
    position: relative;
    min-height: 275px;
    padding: 25px 22px;
    border: 1px solid #e7e9e1;
    background: #fdfdf9;
    transition: transform 0.2s, border-color 0.2s;
  }

  .topic-card:hover {
    transform: translateY(-5px);
    border-color: #a9bca8;
  }

  .topic-number {
    color: #839085;
    font-size: 9px;
    letter-spacing: 1.3px;
    font-weight: 700;
  }

  .topic-icon {
    display: block;
    margin-top: 35px;
    color: #6c8a6d;
    font-size: 31px;
  }

  .topic-card h3 {
    margin: 14px 0 9px;
    font-family: 'DM Serif Display', serif;
    font-size: 23px;
    font-weight: 400;
  }

  .topic-card p {
    margin-bottom: 0;
    color: #7c857d;
    font-size: 12px;
    line-height: 1.7;
  }

  .topic-arrow {
    position: absolute;
    right: 20px;
    bottom: 20px;
    color: #66846b;
    font-size: 17px;
  }

  .nutrition { background: #f0f3eb; }
  .vitamins { background: #f5f1e8; }
  .food { background: #eef2ef; }
  .wellness { background: #f2f0eb; }

  .latest {
    padding-top: 45px;
  }

.article-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.article-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid #e7e9e1;
  background: #fdfdf9;
  transition: transform 0.2s, border-color 0.2s;
}

.article-card:hover {
  transform: translateY(-5px);
  border-color: #a9bca8;
}

.article-thumbnail,
.article-placeholder {
  display: grid;
  width: 100%;
  height: 190px;
  object-fit: cover;
  place-items: center;
  background: #eaf0e7;
}

.article-placeholder span {
  color: #789578;
  font-size: 42px;
}

.article-card-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 22px;
}

.article-category {
  color: #66846b;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.4px;
  text-transform: uppercase;
}

.article-card h3 {
  margin: 13px 0 10px;
  font-family: 'DM Serif Display', serif;
  font-size: 23px;
  font-weight: 400;
  line-height: 1.3;
}

.article-card-content > p {
  color: #788178;
  font-size: 12px;
  line-height: 1.8;
}

.article-card-bottom {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin-top: auto;
  padding-top: 18px;
  color: #879087;
  font-size: 10px;
}

.article-card-bottom span {
  color: #426d4d;
  font-weight: 600;
}

@media (max-width: 900px) {
  .article-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .article-grid {
    grid-template-columns: 1fr;
  }
}

  .empty-state {
    display: flex;
    min-height: 230px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 35px;
    border: 1px dashed #d5dbd1;
    text-align: center;
  }

  .empty-icon {
    color: #789578;
    font-size: 30px;
  }

  .empty-state h3 {
    margin: 13px 0 7px;
    font-family: 'DM Serif Display', serif;
    font-size: 23px;
    font-weight: 400;
  }

  .empty-state p {
    margin: 0;
    color: #879087;
    font-size: 13px;
  }

  .closing {
    margin: 0 clamp(24px, 7vw, 110px);
    padding: 65px 25px;
    background: #edf1e8;
    text-align: center;
  }

  .closing h2 {
    margin-top: 18px;
  }

  .closing > p {
    margin: 17px 0 0;
    color: #788178;
    font-size: 13px;
  }

  .closing-button {
    margin-top: 25px;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 75px;
      padding-bottom: 50px;
    }

    .hero-art {
      min-height: 300px;
    }

    .intro {
      gap: 35px;
    }

    .topic-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding-top: 65px;
    }

    .hero h1 {
      letter-spacing: -1.5px;
    }

    .hero-art {
      min-height: 270px;
    }

    .circle-one {
      width: 260px;
      height: 260px;
    }

    .circle-two {
      width: 210px;
      height: 210px;
    }

    .intro {
      grid-template-columns: 1fr;
      padding-top: 70px;
      padding-bottom: 55px;
    }

    .topic-grid {
      grid-template-columns: 1fr;
    }

    .topic-card {
      min-height: 245px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .closing {
      padding: 55px 18px;
    }
  }
</style>
