
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = ['All', 'Nutrition', 'Vitamins', 'Food', 'Wellness'];
---

<BaseLayout
  title="All Articles | Finavit"
  description="Explore nutrition, vitamins, food, and wellness articles from Finavit."
>
  <main class="articles-page">
    <header class="page-header">
      <span class="eyebrow">THE FINAVIT JOURNAL</span>
      <h1>Explore our <em>articles.</em></h1>
      <p>Practical nutrition knowledge, food guides, and wellness insights to help you make informed choices.</p>
      <span class="article-count">{articles.length} PUBLISHED ARTICLES</span>
    </header>

    <nav class="category-list" aria-label="Article categories">
      {categories.map((category) => (
        <a
          href={category === 'All'
            ? '/blog/articles/'
            : `/blog/category/${category.toLowerCase()}/`}
          class:list={['category-link', { active: category === 'All' }]}
        >
          {category}
        </a>
      ))}
    </nav>

    {articles.length > 0 ? (
      <section class="article-grid">
        {articles.map((article) => (
          <a class="article-card" href={`/blog/${article.id}/`}>
            {article.data.image ? (
              <img
                src={article.data.image}
                alt={article.data.imageAlt || article.data.title}
              />
            ) : (
              <div class="article-placeholder">✳</div>
            )}

            <div class="card-content">
              <span class="category">{article.data.category}</span>
              <h2>{article.data.title}</h2>
              <p>{article.data.description}</p>
              <div class="card-bottom">
                <time datetime={article.data.pubDate.toISOString()}>
                  {article.data.pubDate.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </time>
                <span>Read article ↗</span>
              </div>
            </div>
          </a>
        ))}
      </section>
    ) : (
      <div class="empty-state">
        <span>✳</span>
        <h2>Good reads are on the way.</h2>
        <p>We're preparing our first collection of nutrition and food guides.</p>
      </div>
    )}

    <section class="finavit-cta">
      <span class="eyebrow">GO BEYOND READING</span>
      <h2>Make better-informed health choices.</h2>
      <p>Explore Finavit's nutrition tools, food library, health insights, and AI health assistant.</p>
      <a href="https://finavit.com/" target="_blank" rel="noopener noreferrer">
        Explore Finavit ↗
      </a>
      <small>Most features are free to use, without creating an account.</small>
    </section>
  </main>
</BaseLayout>

<style>
  .articles-page {
    max-width: 1120px;
    margin: 0 auto;
    padding: 75px 28px 100px;
  }

  .page-header {
    max-width: 720px;
    margin-bottom: 45px;
  }

  .eyebrow {
    color: #66846b;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .page-header h1 {
    margin: 18px 0;
    font-family: 'DM Serif Display', serif;
    font-size: clamp(42px, 6vw, 68px);
    font-weight: 400;
    line-height: 1.1;
  }

  .page-header h1 em {
    color: #66846b;
  }

  .page-header p {
    max-width: 570px;
    color: #788178;
    font-size: 15px;
    line-height: 1.8;
  }

  .article-count {
    display: inline-block;
    margin-top: 20px;
    color: #879087;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 35px;
    padding-bottom: 22px;
    border-bottom: 1px solid #e7e9e1;
  }

  .category-link {
    padding: 10px 17px;
    border: 1px solid #e7e9e1;
    color: #667267;
    font-size: 12px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .category-link:hover,
  .category-link.active {
    border-color: #66846b;
    background: #eaf0e7;
    color: #426d4d;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #e7e9e1;
    background: #fdfdf9;
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s, border-color 0.2s;
  }

  .article-card:hover {
    transform: translateY(-5px);
    border-color: #a9bca8;
  }

  .article-card img,
  .article-placeholder {
    display: grid;
    width: 100%;
    height: 190px;
    object-fit: cover;
    place-items: center;
    background: #eaf0e7;
  }

  .article-placeholder {
    color: #789578;
    font-size: 42px;
  }

  .card-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px;
  }

  .category {
    color: #66846b;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }

  .card-content h2 {
    margin: 13px 0 10px;
    font-family: 'DM Serif Display', serif;
    font-size: 23px;
    font-weight: 400;
    line-height: 1.3;
  }

  .card-content p {
    color: #788178;
    font-size: 12px;
    line-height: 1.8;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-top: auto;
    padding-top: 18px;
    color: #879087;
    font-size: 10px;
  }

  .card-bottom span {
    color: #426d4d;
    font-weight: 600;
  }

  .empty-state {
    padding: 65px 20px;
    text-align: center;
    background: #f5f7f1;
  }

  .empty-state > span {
    color: #789578;
    font-size: 38px;
  }

  .empty-state h2 {
    font-family: 'DM Serif Display', serif;
    font-weight: 400;
  }

  .empty-state p {
    color: #788178;
    font-size: 13px;
  }

  .finavit-cta {
    margin-top: 85px;
    padding: 55px 30px;
    background: #edf2e9;
    text-align: center;
  }

  .finavit-cta h2 {
    margin: 15px 0;
    font-family: 'DM Serif Display', serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 400;
  }

  .finavit-cta p {
    max-width: 550px;
    margin: 0 auto 25px;
    color: #788178;
    font-size: 13px;
    line-height: 1.8;
  }

  .finavit-cta a {
    display: inline-block;
    padding: 14px 25px;
    background: #426d4d;
    color: white;
    font-size: 12px;
    text-decoration: none;
  }

  .finavit-cta small {
    display: block;
    margin-top: 15px;
    color: #788178;
    font-size: 10px;
  }

  @media (max-width: 900px) {
    .article-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .article-grid {
      grid-template-columns: 1fr;
    }

    .articles-page {
      padding: 50px 18px 70px;
    }
  }
</style>
