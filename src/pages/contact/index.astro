
---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us | Finavit Journal"
  description="Contact the Finavit Journal team with questions, feedback, article corrections, or editorial suggestions."
>
  <section class="hero">
    <span class="eyebrow">WE'D LOVE TO HEAR FROM YOU</span>
    <h1>Get in <em>touch.</em></h1>
    <p>
      Have a question, spotted an error, or want to share feedback?
      We're happy to hear from you.
    </p>
  </section>

  <main class="contact-content">
    <div class="contact-card">
      <span class="icon">✉</span>
      <h2>General inquiries</h2>
      <p>
        For general questions, feedback, or suggestions about
        Finavit Journal.
      </p>
      <a href="mailto:privacy@finavit.com">
        privacy@finavit.com
      </a>
    </div>

    <div class="contact-card">
      <span class="icon">✎</span>
      <h2>Article corrections</h2>
      <p>
        Found something inaccurate or outdated in one of our articles?
        Let us know which article needs attention and include a
        reference if possible.
      </p>
      <a href="mailto:privacy@finavit.com?subject=Article%20Correction">
        Report a correction ↗
      </a>
    </div>

    <div class="contact-card">
      <span class="icon">◎</span>
      <h2>Privacy inquiries</h2>
      <p>
        For questions or requests concerning how information is
        handled on our website.
      </p>
      <a href="mailto:privacy@finavit.com?subject=Privacy%20Inquiry">
        Contact us about privacy ↗
      </a>
    </div>

    <div class="note">
      <strong>A quick note</strong>
      <p>
        Finavit Journal provides educational information about
        nutrition, food, vitamins, and wellness. We cannot provide
        individual medical advice or emergency assistance through
        email. For medical concerns, please consult a qualified
        healthcare professional.
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  .hero {
    padding: 90px 24px 75px;
    text-align: center;
    background: #f0f2e9;
  }

  .eyebrow {
    color: #68806d;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .hero h1 {
    margin: 22px 0 14px;
    font-family: 'DM Serif Display', serif;
    font-size: clamp(42px, 7vw, 66px);
    font-weight: 400;
  }

  .hero h1 em {
    color: #52745a;
  }

  .hero p {
    max-width: 580px;
    margin: auto;
    color: #68736a;
    font-size: 15px;
    line-height: 1.8;
  }

  .contact-content {
    max-width: 850px;
    margin: 0 auto;
    padding: 70px 24px 85px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .contact-card {
    padding: 30px;
    border: 1px solid #e5e8df;
    border-radius: 12px;
    background: #fdfdf9;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: #edf1e9;
    color: #315e42;
    font-size: 20px;
  }

  .contact-card h2 {
    margin: 22px 0 10px;
    font-family: 'DM Serif Display', serif;
    font-size: 23px;
    font-weight: 400;
  }

  .contact-card p,
  .note p {
    color: #68736a;
    font-size: 13px;
    line-height: 1.8;
  }

  .contact-card a {
    display: inline-block;
    margin-top: 12px;
    color: #315e42;
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .note {
    grid-column: 1 / -1;
    padding: 24px;
    border-left: 3px solid #52745a;
    background: #f0f2e9;
    color: #526157;
  }

  .note p {
    margin-bottom: 0;
  }

  @media (max-width: 600px) {
    .contact-content {
      grid-template-columns: 1fr;
    }

    .note {
      grid-column: auto;
    }
  }
</style>
